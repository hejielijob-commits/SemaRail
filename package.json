{
  "name": "@hejielijob/semarail-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && pnpm run test:sidecar && pnpm run test:semantic-console",
    "test:sidecar": "node scripts/test-sidecar.mjs",
    "test:semantic-console": "node scripts/test-semantic-console.mjs",
    "typecheck": "pnpm --filter @hejielijob/semarail-contract build && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "acceptance:mcp": "node scripts/run-wren-mcp-acceptance.mjs",
    "acceptance:core": "pnpm --filter @hejielijob/semarail-core test",
    "acceptance:postgres": "pwsh -NoLogo -NoProfile -File scripts/acceptance-postgres.ps1",
    "acceptance:control-postgres": "pwsh -NoLogo -NoProfile -File scripts/acceptance-control-postgres.ps1",
    "evaluate:golden": "pwsh -NoLogo -NoProfile -File scripts/evaluate-golden.ps1",
    "benchmark:hr:prepare": "pwsh -NoLogo -NoProfile -File scripts/hr-benchmark.ps1 prepare",
    "benchmark:hr": "pwsh -NoLogo -NoProfile -File scripts/hr-benchmark.ps1 run",
    "benchmark:hr:evaluate": "pwsh -NoLogo -NoProfile -File scripts/hr-benchmark.ps1 evaluate",
    "benchmark:hr:clean": "pwsh -NoLogo -NoProfile -File scripts/hr-benchmark.ps1 clean",
    "test:hr-benchmark": "pwsh -NoLogo -NoProfile -File scripts/hr-benchmark.ps1 test",
    "probe:sidecar": "node scripts/probe-sidecar.mjs",
    "package:core": "node scripts/package-distribution.mjs"
  }
}
