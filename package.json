{
  "name": "@hejielijob/dsh-wren-data-agent-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && pnpm run test:sidecar && pnpm run test:semantic-console",
    "test:sidecar": "node scripts/test-sidecar.mjs",
    "test:semantic-console": "node scripts/test-semantic-console.mjs",
    "typecheck": "pnpm --filter @hejielijob/dsh-wren-data-agent-contract build && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "acceptance": "pwsh -NoLogo -NoProfile -File scripts/acceptance.ps1",
    "acceptance:mcp": "node scripts/run-wren-mcp-acceptance.mjs",
    "acceptance:split": "pnpm --filter @hejielijob/semarail-core build && node scripts/acceptance-split.mjs",
    "acceptance:postgres": "pwsh -NoLogo -NoProfile -File scripts/acceptance-postgres.ps1",
    "acceptance:replay": "node scripts/acceptance-replay.mjs",
    "evaluate:golden": "pwsh -NoLogo -NoProfile -File scripts/evaluate-golden.ps1",
    "probe:sidecar": "node scripts/probe-sidecar.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "package:core": "node scripts/package-distribution.mjs core",
    "package:harness-plugin": "node scripts/package-distribution.mjs dsh-plugin",
    "package:split": "pnpm run package:core && pnpm run package:harness-plugin"
  }
}
