{
  "openapi": "3.0.3",
  "info": {
    "title": "SemaRail Semantic Console",
    "version": "1.0.0",
    "description": "Local-only SemaRail Semantic Console API. Success responses are the resource/list directly; errors are {code,message,details}. Datasource credentials are accepted only by write requests, held in the server's local secret state file, and never returned or written to a semantic project."
  },
  "servers": [{"url": "http://127.0.0.1:48763"}],
  "paths": {
    "/api/v1/runtime/rpc": {"post": {"operationId": "runtimeRpc", "description": "Versioned agent runtime boundary. Core pins project, credential source, query limits, and the authenticated subject's current policy.", "security": [{"RuntimeBearer": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["protocolVersion", "id", "method", "params"], "additionalProperties": false, "properties": {"protocolVersion": {"type": "string", "enum": ["1"]}, "id": {"type": "string", "minLength": 1, "maxLength": 128}, "method": {"type": "string", "enum": ["health", "project.validate", "project.describe", "context.ask", "query.dryPlan", "query.run", "query.cancel"]}, "params": {"type": "object"}, "deadlineMs": {"type": "integer"}}}}}}, "responses": {"200": {"description": "Versioned RPC response"}, "400": {"description": "Invalid or incompatible request"}, "401": {"description": "Missing or invalid bearer token"}, "403": {"description": "Current subject policy does not allow the operation"}, "503": {"description": "Core runtime unavailable"}}}},
    "/api/v1/access/service-accounts": {
      "get": {"operationId": "listServiceAccounts", "security": [{"RuntimeBearer": []}], "responses": {"200": {"description": "Service accounts with redacted credential metadata"}, "401": {"description": "Authentication required"}, "403": {"description": "Administrator permission required"}}},
      "post": {"operationId": "createServiceAccount", "security": [{"RuntimeBearer": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "organizationId": {"type": "string"}, "attributes": {"type": "object", "additionalProperties": true}}}}}}, "responses": {"201": {"description": "Created service account"}, "400": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/v1/access/service-accounts/{id}": {"put": {"operationId": "updateServiceAccount", "security": [{"RuntimeBearer": []}], "parameters": [{"$ref": "#/components/parameters/AccessId"}], "description": "Replace trusted name or subject attributes; changes apply on the next request.", "responses": {"200": {"description": "Updated service account"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/api/v1/access/service-accounts/{id}/status": {"put": {"operationId": "setServiceAccountStatus", "security": [{"RuntimeBearer": []}], "parameters": [{"$ref": "#/components/parameters/AccessId"}], "responses": {"200": {"description": "Updated status"}}}},
    "/api/v1/access/service-accounts/{id}/keys": {"post": {"operationId": "issueServiceAccountKey", "security": [{"RuntimeBearer": []}], "parameters": [{"$ref": "#/components/parameters/AccessId"}], "description": "Issue a key whose plaintext is returned once and never persisted.", "responses": {"201": {"description": "One-time API key and redacted credential metadata"}}}},
    "/api/v1/access/credentials/{id}/rotate": {"post": {"operationId": "rotateServiceAccountKey", "security": [{"RuntimeBearer": []}], "parameters": [{"$ref": "#/components/parameters/AccessId"}], "description": "Atomically issue a replacement and revoke the old credential.", "responses": {"201": {"description": "One-time replacement API key"}}}},
    "/api/v1/access/credentials/{id}/revoke": {"post": {"operationId": "revokeServiceAccountKey", "security": [{"RuntimeBearer": []}], "parameters": [{"$ref": "#/components/parameters/AccessId"}], "responses": {"200": {"description": "Revoked credential metadata"}}}},
    "/api/v1/access/policies": {
      "get": {"operationId": "listAccessPolicies", "security": [{"RuntimeBearer": []}], "responses": {"200": {"description": "Versioned policies"}}},
      "post": {"operationId": "createAccessPolicy", "security": [{"RuntimeBearer": []}], "responses": {"201": {"description": "Created policy"}, "400": {"description": "Invalid policy document"}}}
    },
    "/api/v1/access/policies/{id}": {"put": {"operationId": "updateAccessPolicy", "security": [{"RuntimeBearer": []}], "parameters": [{"$ref": "#/components/parameters/AccessId"}], "description": "Replace the document and increment its version; changes apply on the next request.", "responses": {"200": {"description": "Updated policy"}, "400": {"description": "Invalid policy document"}}}},
    "/api/v1/access/policy-bindings": {"post": {"operationId": "bindAccessPolicy", "security": [{"RuntimeBearer": []}], "responses": {"201": {"description": "Policy binding"}}}},
    "/api/v1/access/audit": {"get": {"operationId": "listAccessAudit", "security": [{"RuntimeBearer": []}], "responses": {"200": {"description": "Bounded newest-first audit events"}}}},
    "/api/health": {"get": {"operationId": "health", "responses": {"200": {"description": "Process and semantic-runtime readiness", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}}},
    "/api/mcp-integration": {"get": {"operationId": "getMcpIntegration", "responses": {"200": {"description": "Secret-free stdio MCP readiness, launch commands, and generic client configuration"}}}},
    "/api/project": {"get": {"operationId": "getProject", "responses": {"200": {"description": "Project overview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectOverview"}}}}}}},
    "/api/datasource-types": {"get": {"operationId": "listDatasourceTypes", "responses": {"200": {"description": "Datasource types", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/DatasourceType"}}}}}}}},
    "/api/datasources": {
      "get": {"operationId": "listDatasources", "responses": {"200": {"description": "Redacted datasource profiles", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Datasource"}}}}}}},
      "post": {"operationId": "createDatasource", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DatasourceInput"}}}}, "responses": {"201": {"description": "Created redacted profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Datasource"}}}}, "400": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/datasources/{id}": {
      "parameters": [{"$ref": "#/components/parameters/DatasourceId"}],
      "get": {"operationId": "getDatasource", "responses": {"200": {"description": "Redacted profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Datasource"}}}}}},
      "put": {"operationId": "updateDatasource", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DatasourceInput"}}}}, "responses": {"200": {"description": "Updated redacted profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Datasource"}}}}}},
      "delete": {"operationId": "deleteDatasource", "responses": {"200": {"description": "Deleted profile", "content": {"application/json": {"schema": {"type": "object", "required": ["id", "deleted"], "properties": {"id": {"type": "string"}, "deleted": {"type": "boolean"}}}}}}}}
    },
    "/api/datasources/{id}/activate": {"post": {"operationId": "activateDatasource", "parameters": [{"$ref": "#/components/parameters/DatasourceId"}], "responses": {"200": {"description": "Active profile and project overview"}}}},
    "/api/datasources/{id}/test": {"post": {"operationId": "testDatasource", "parameters": [{"$ref": "#/components/parameters/DatasourceId"}], "responses": {"200": {"description": "Connection test result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TestResult"}}}}}}},
    "/api/datasources/{id}/schemas": {"get": {"operationId": "listSchemas", "parameters": [{"$ref": "#/components/parameters/DatasourceId"}], "responses": {"200": {"description": "Database schemas", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/NameItem"}}}}}}}},
    "/api/datasources/{id}/tables": {"get": {"operationId": "listTables", "parameters": [{"$ref": "#/components/parameters/DatasourceId"}, {"name": "schema", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Tables", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Table"}}}}}}}},
    "/api/datasources/{id}/columns": {"get": {"operationId": "listColumns", "parameters": [{"$ref": "#/components/parameters/DatasourceId"}, {"name": "schema", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "table", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Columns", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Column"}}}}}}}},
    "/api/datasources/{id}/models": {"post": {"operationId": "generateModel", "parameters": [{"$ref": "#/components/parameters/DatasourceId"}, {"name": "schema", "in": "query", "schema": {"type": "string"}}, {"name": "table", "in": "query", "schema": {"type": "string"}}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/GenerateModelInput"}}}}, "responses": {"201": {"description": "Generated model draft"}}}},
    "/api/project/import": {"post": {"operationId": "importProject", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImportInput"}}}}, "responses": {"200": {"description": "Imported draft files"}}}},
    "/api/project/files": {"get": {"operationId": "listProjectFiles", "responses": {"200": {"description": "Project file metadata", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/FileInfo"}}}}}}}},
    "/api/semantic-project": {"get": {"operationId": "getSemanticProject", "responses": {"200": {"description": "Structured business-model snapshot for the visual editor", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SemanticProjectSnapshot"}}}}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/api/semantic-models/{name}": {
      "parameters": [{"name": "name", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$-]*$"}}],
      "put": {"operationId": "updateSemanticModel", "description": "Merge visual business-model fields into models/<name>/metadata.yml and semantic-console/locales.yml as one revision-checked draft update.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SemanticModelInput"}}}}, "responses": {"200": {"description": "Updated semantic project snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SemanticProjectSnapshot"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/semantic-relationships": {"put": {"operationId": "updateSemanticRelationships", "description": "Replace the relationship list while preserving unknown semantic-project keys and update the bilingual companion file atomically.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SemanticRelationshipsInput"}}}}, "responses": {"200": {"description": "Updated semantic project snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SemanticProjectSnapshot"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/cubes": {"get": {"operationId": "listCubes", "responses": {"200": {"description": "Cube project snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CubeSnapshot"}}}}}}, "post": {"operationId": "createCube", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CubeInput"}}}}, "responses": {"201": {"description": "Created cube draft"}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/cubes/{name}": {"parameters": [{"$ref": "#/components/parameters/CubeName"}], "get": {"operationId": "getCube", "responses": {"200": {"description": "Cube definition"}}}, "put": {"operationId": "updateCube", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CubeInput"}}}}, "responses": {"200": {"description": "Updated cube snapshot"}, "409": {"$ref": "#/components/responses/Error"}}}, "delete": {"operationId": "deleteCube", "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"expectedRevision": {"type": "string", "minLength": 1}}}}}}, "responses": {"200": {"description": "Cube snapshot after deletion"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/cubes/{name}/validate": {"post": {"operationId": "validateCube", "parameters": [{"$ref": "#/components/parameters/CubeName"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CubeInput"}}}}, "responses": {"200": {"description": "Cube validation result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CubeValidation"}}}}}}},
    "/api/views": {"get": {"operationId": "listViews", "responses": {"200": {"description": "SemaRail view project snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewSnapshot"}}}}}}, "post": {"operationId": "createView", "description": "Create a draft view. New views store their statement in views/<name>/sql.yml unless storage is explicitly metadata.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewCreateInput"}}}}, "responses": {"201": {"description": "Created view draft", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewSnapshot"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/views/{name}": {"parameters": [{"$ref": "#/components/parameters/ViewName"}], "get": {"operationId": "getView", "responses": {"200": {"description": "View definition", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewRecord"}}}}, "404": {"$ref": "#/components/responses/Error"}}}, "put": {"operationId": "updateView", "description": "Update a draft view and atomically switch inline metadata/sql.yml storage when requested.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewUpdateInput"}}}}, "responses": {"200": {"description": "Updated view snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewSnapshot"}}}}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}, "delete": {"operationId": "deleteView", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevisionInput"}}}}, "responses": {"200": {"description": "View snapshot after deletion", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewSnapshot"}}}}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/api/views/{name}/validate": {"post": {"operationId": "validateView", "parameters": [{"$ref": "#/components/parameters/ViewName"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewUpdateInput"}}}}, "responses": {"200": {"description": "Read-only view validation result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewValidation"}}}}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/api/views/{name}/preview": {"post": {"operationId": "previewView", "description": "Run the named View from an isolated current-draft snapshot through the shared SemaRail Core policy boundary. The server generates semantic SQL and enforces read-only planning, physical allowlists, timeout, row, and byte limits.", "parameters": [{"$ref": "#/components/parameters/ViewName"}], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewPreviewInput"}}}}, "responses": {"200": {"description": "Bounded database runtime preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ViewPreview"}}}}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}, "504": {"$ref": "#/components/responses/Error"}}}},
    "/api/knowledge/rules": {"get": {"operationId": "listKnowledgeRules", "responses": {"200": {"description": "Individual rule records and project revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RulesSnapshot"}}}}}}, "post": {"operationId": "createKnowledgeRule", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleInput"}}}}, "responses": {"201": {"description": "Created rule draft"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/api/knowledge/rules/{id}": {"parameters": [{"$ref": "#/components/parameters/RuleId"}], "get": {"operationId": "getKnowledgeRule", "responses": {"200": {"description": "Rule record"}}}, "put": {"operationId": "updateKnowledgeRule", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleInput"}}}}, "responses": {"200": {"description": "Updated rule draft"}}}, "delete": {"operationId": "deleteKnowledgeRule", "responses": {"200": {"description": "Deleted rule"}}}},
    "/api/knowledge/rules/{id}/enable": {"post": {"operationId": "enableKnowledgeRule", "parameters": [{"$ref": "#/components/parameters/RuleId"}], "responses": {"200": {"description": "Enabled rule draft"}}}},
    "/api/knowledge/rules/{id}/disable": {"post": {"operationId": "disableKnowledgeRule", "parameters": [{"$ref": "#/components/parameters/RuleId"}], "responses": {"200": {"description": "Disabled rule draft"}}}},
    "/api/knowledge/sql-candidates": {"get": {"operationId": "listSqlCandidates", "parameters": [{"$ref": "#/components/parameters/ReviewStatus"}], "responses": {"200": {"description": "SQL review queue", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SqlCandidateSnapshot"}}}}}}, "post": {"operationId": "submitSqlCandidate", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SqlCandidateInput"}}}}, "responses": {"201": {"description": "Pending SQL candidate"}, "200": {"description": "Existing candidate returned for a duplicate submission"}}}},
    "/api/knowledge/sql-candidates/{id}": {"parameters": [{"$ref": "#/components/parameters/CandidateId"}], "get": {"operationId": "getSqlCandidate", "responses": {"200": {"description": "SQL candidate"}}}, "put": {"operationId": "updateSqlCandidate", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SqlCandidateInput"}}}}, "responses": {"200": {"description": "Updated pending candidate"}}}},
    "/api/knowledge/sql-candidates/{id}/validate": {"post": {"operationId": "validateSqlCandidate", "description": "Parse and safety-check the candidate (or a reviewer SQL override) without changing review status.", "parameters": [{"$ref": "#/components/parameters/CandidateId"}], "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"sql": {"type": "string", "maxLength": 2097152}}}}}}, "responses": {"200": {"description": "Read-only SQL validation result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SqlValidation"}}}}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/api/knowledge/sql-candidates/{id}/approve": {"post": {"operationId": "approveSqlCandidate", "parameters": [{"$ref": "#/components/parameters/CandidateId"}], "responses": {"200": {"description": "Approved candidate and SQL project draft"}}}},
    "/api/knowledge/sql-candidates/{id}/reject": {"post": {"operationId": "rejectSqlCandidate", "parameters": [{"$ref": "#/components/parameters/CandidateId"}], "responses": {"200": {"description": "Rejected candidate"}}}},
    "/api/knowledge/sql-candidates/{id}/resubmit": {"post": {"operationId": "resubmitSqlCandidate", "parameters": [{"$ref": "#/components/parameters/CandidateId"}], "responses": {"200": {"description": "Pending candidate"}}}},
    "/api/project/diff": {"get": {"operationId": "getProjectDiff", "parameters": [{"$ref": "#/components/parameters/FilePath"}], "responses": {"200": {"description": "Bounded unified diff between published content and the current draft", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectDiff"}}}}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/api/project/file": {
      "get": {"operationId": "readProjectFile", "parameters": [{"$ref": "#/components/parameters/FilePath"}], "responses": {"200": {"description": "Draft-aware file", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileContent"}}}}}},
      "put": {"operationId": "editProjectFile", "parameters": [{"$ref": "#/components/parameters/FilePath"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileEdit"}}}}, "responses": {"200": {"description": "Updated draft metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DraftResult"}}}}}}
    },
    "/api/project/validate": {"post": {"operationId": "validateProject", "responses": {"200": {"description": "Validation result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ValidationResult"}}}}}}},
    "/api/project/publish": {"post": {"operationId": "publishProject", "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"label": {"type": "string", "maxLength": 120}}}}}}, "responses": {"200": {"description": "Published version"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/api/versions": {"get": {"operationId": "listVersions", "responses": {"200": {"description": "Published versions", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Version"}}}}}}}},
    "/api/versions/{id}/rollback": {"post": {"operationId": "rollbackVersion", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Restored version"}, "404": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "securitySchemes": {"RuntimeBearer": {"type": "http", "scheme": "bearer"}},
    "parameters": {
      "DatasourceId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
      "AccessId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 160}},
      "RuleId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^rule_[A-Za-z0-9_-]{8,100}$"}},
      "CubeName": {"name": "name", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$-]*$"}},
      "ViewName": {"name": "name", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$-]*$"}},
      "CandidateId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^sql_[A-Za-z0-9_-]{8,100}$"}},
      "ReviewStatus": {"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["pending", "approved", "rejected"]}},
      "FilePath": {"name": "path", "in": "query", "required": true, "schema": {"type": "string", "example": "models/orders/metadata.yml"}}
    },
    "responses": {"Error": {"description": "Safe error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}},
    "schemas": {
      "Error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object", "additionalProperties": true}}},
      "Health": {"type": "object", "required": ["status", "service", "apiVersion", "wren"], "properties": {"status": {"type": "string"}, "service": {"type": "string"}, "apiVersion": {"type": "string"}, "wren": {"type": "object", "additionalProperties": true}, "datasourceCount": {"type": "integer"}}},
      "ProjectOverview": {"type": "object", "additionalProperties": true, "properties": {"name": {"type": ["string", "null"]}, "schemaVersion": {"type": ["integer", "null"]}, "dataSource": {"type": ["string", "null"]}, "revision": {"type": "string"}, "draftCount": {"type": "integer"}, "activeDatasource": {"$ref": "#/components/schemas/Datasource"}}},
      "DatasourceType": {"type": "object", "required": ["type", "label", "available", "fields"], "properties": {"type": {"type": "string"}, "label": {"type": "string"}, "available": {"type": "boolean"}, "module": {"type": ["string", "null"]}, "supportsSchemaBrowse": {"type": "boolean"}, "supportsTest": {"type": "boolean"}, "fields": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}},
      "Datasource": {"type": "object", "required": ["id", "name", "type", "connection", "hasPassword"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "type": {"type": "string"}, "connection": {"type": "object", "description": "Redacted non-secret fields only"}, "hasPassword": {"type": "boolean"}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "lastTest": {"type": ["object", "null"]}}},
      "DatasourceInput": {"type": "object", "required": ["type"], "properties": {"name": {"type": "string"}, "type": {"type": "string", "enum": ["postgres", "mysql", "sqlite", "clickhouse", "duckdb"]}, "connection": {"type": "object", "additionalProperties": true, "description": "Password accepted here only; never returned"}}},
      "NameItem": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}},
      "Table": {"allOf": [{"$ref": "#/components/schemas/NameItem"}, {"type": "object", "properties": {"type": {"type": "string"}}}]},
      "Column": {"type": "object", "required": ["name", "type", "nullable", "primaryKey"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "dataType": {"type": "string"}, "nullable": {"type": "boolean"}, "ordinal": {"type": "integer"}, "primaryKey": {"type": "boolean"}}},
      "TestResult": {"type": "object", "required": ["ok"], "properties": {"ok": {"type": "boolean"}, "latencyMs": {"type": "number"}, "driver": {"type": "string"}, "code": {"type": "string"}, "message": {"type": "string"}}},
      "GenerateModelInput": {"type": "object", "properties": {"name": {"type": "string"}, "schema": {"type": "string"}, "table": {"type": "string"}, "overwrite": {"type": "boolean"}}},
      "ImportInput": {"type": "object", "properties": {"path": {"type": "string"}, "projectDir": {"type": "string"}, "files": {"type": "array", "items": {"$ref": "#/components/schemas/FileEdit"}}}},
