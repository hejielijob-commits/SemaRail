{
  "name": "@hejielijob/dsh-wren-data-agent-client",
  "version": "0.1.0",
  "description": "DeepSeek Harness Client plugin for the Wren data_query tool.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "scripts/build.mjs"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-tool": "0.1.0-rc.7",
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
