{
  "name": "@hejielijob/dsh-wren-data-agent-client",
  "version": "0.1.0",
  "description": "DeepSeek Harness Client plugin for the Wren data_query view and semantic-console sidebar action.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "licenses/**/*",
    "scripts/build.mjs"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:lazy-cjs": "node scripts/verify-lazy-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.10 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.10 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.10 <0.2.0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.0-rc.10 <0.2.0",
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "18.3.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.1-rc.2",
    "echarts": "5.6.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
