{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-client-runtime/client": [
        "node_modules/@deepseek-ai/dsh-client-runtime/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar/client": [
        "node_modules/@deepseek-ai/dsh-client-ui-sidebar/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-tool/client": [
        "node_modules/@deepseek-ai/dsh-client-ui-tool/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "node_modules/@deepseek-ai/dsh-client-ui-slots/lib/types/index.d.ts"
      ]
    },
    "declaration": true,
    "declarationMap": false,
    "declarationDir": ".build/client-cjs/types",
    "outDir": ".build/client-cjs",
    "rootDir": "src/client"
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
