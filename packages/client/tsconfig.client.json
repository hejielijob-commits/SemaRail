{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "declarationMap": false,
    "declarationDir": ".build/client-cjs/types",
    "outDir": ".build/client-cjs",
    "rootDir": "src/client"
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
