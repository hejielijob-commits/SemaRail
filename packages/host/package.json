{
  "name": "@hejielijob/dsh-wren-data-agent-host",
  "version": "0.1.0",
  "description": "DeepSeek Harness Host plugin for the SemaRail query boundary.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "runtime/bootstrap.py",
    "runtime/constraints.txt",
    "python/sidecar/pyproject.toml",
    "python/sidecar/README.md",
    "python/sidecar/sidecar/**/*.py",
    "python/semantic-console/pyproject.toml",
    "python/semantic-console/server/**/*.py",
    "semantic-console-web/**/*"
  ],
  "scripts": {
    "stage-sidecar": "node scripts/stage-sidecar.mjs",
    "build-console-web": "pnpm --filter @hejielijob/semantic-console-web build",
    "stage-semantic-console": "pnpm run build-console-web && node scripts/stage-semantic-console.mjs",
    "build": "pnpm run stage-sidecar && pnpm run stage-semantic-console && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run stage-sidecar && pnpm run stage-semantic-console && vitest run && node scripts/test-runtime-bootstrap.mjs && pnpm run verify-pack",
    "verify-pack": "node scripts/verify-packaged-sidecar.mjs"
  },
  "dependencies": {
    "@hejielijob/dsh-wren-data-agent-contract": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.10 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.10 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.10 <0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
