{
  "name": "@hejielijob/dsh-semarail-plugin",
  "version": "0.1.0-alpha.3",
  "description": "Thin DeepSeek Harness integration for an independently running SemaRail Core.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run && pnpm run build && pnpm run verify-pack",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.10 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.10 <0.2.0"
  },
  "devDependencies": {
    "@hejielijob/dsh-wren-data-agent-client": "workspace:*",
    "@hejielijob/dsh-wren-data-agent-contract": "workspace:*",
    "@hejielijob/dsh-wren-data-agent-host": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "license": "MIT"
}
