{
  "name": "@hejielijob/dsh-wren-data-agent",
  "version": "0.1.0",
  "description": "Installable DeepSeek Harness Bundle for SemaRail.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "runtime/bootstrap.py",
    "runtime/constraints.txt",
    "python/sidecar/pyproject.toml",
    "python/sidecar/README.md",
    "python/sidecar/sidecar/**/*.py",
    "python/semantic-console/pyproject.toml",
    "python/semantic-console/server/**/*.py",
    "semantic-console-web/**/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && pnpm run verify-pack",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.10 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.10 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.10 <0.2.0"
  },
  "devDependencies": {
    "@hejielijob/dsh-wren-data-agent-client": "workspace:*",
    "@hejielijob/dsh-wren-data-agent-contract": "workspace:*",
    "@hejielijob/dsh-wren-data-agent-host": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "license": "MIT"
}
